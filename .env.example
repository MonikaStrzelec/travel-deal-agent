# Copy this file to .env. Environment variables override this file.
TDA_DATABASE=data/offers.sqlite3
TDA_LOG_LEVEL=INFO
TDA_CONFIG=config.json
# Future API credentials belong here, never in source code.

# Optional positive override for the manual ITAKA adapter
# ITAKA_MAX_PAGES=2

# Telegram Bot API credentials for TelegramNotifier; must be set together.
# Leave both unset to keep using ConsoleNotifier (local logging only).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
